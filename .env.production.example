# Production Environment Variables for Render + Supabase Deployment

# Database (FREE Supabase PostgreSQL)
# Get from: supabase.com → Your Project → Settings → Database → Connection String
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password_here@db.xxx.supabase.co:5432/postgres

# API Configuration
NODE_ENV=production
API_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=https://rd-intel-frontend.onrender.com

# Authentication
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
