# Production Environment Variables for Render Deployment

# Database (Render PostgreSQL)
# Format: postgresql://[username]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://rd_intel_user:your_password_here@pg-xxx.render.com:5432/rd_intel

# API Configuration
NODE_ENV=production
API_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=https://rd-intel-frontend.onrender.com

# Authentication
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
